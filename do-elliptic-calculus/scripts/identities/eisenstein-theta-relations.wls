(* ::Subsection::Closed:: *)
(*Eisenstein -> \[Theta]^(n)/\[Theta] functions*)


(* ::Input::Initialization:: *)
Clear[EisensteinToTheta]
EisensteinToTheta[f_]:=Block[{\[CurlyTheta]ps,rule,k,y},
\[CurlyTheta]ps[pnum_]:=Symbol[StringJoin@@("\[CurlyTheta]"<>ConstantArray["p",pnum])];

rule=Table[EEE[k][{
 {1},
 {z_}
}][q]:>Evaluate[((-1)^(k-1) E^(y/(2\[Pi] I) Dz+Sum[EEi[2nn][q]/(2nn) y^(2nn),{nn,1,40}])//SeriesCoefficient[#,{y,0,k}]&//Expand)/.{Dz->\[CurlyTheta]p[1][\[ScriptZ],q]/\[CurlyTheta][1][\[ScriptZ],q],Dz^n_:>\[CurlyTheta]ps[n][1][\[ScriptZ],q]/\[CurlyTheta][1][\[ScriptZ],q]}/.{\[ScriptZ]->1/(2\[Pi] I) Log[z]}],{k,1,maxDerivativeOrder}]~Join~Table[EEE[k][{
 {-1},
 {z_}
}][q]:>Evaluate[((-1)^(k-1) E^(y/(2\[Pi] I) Dz+Sum[EEi[2nn][q]/(2nn) y^(2nn),{nn,1,40}])//SeriesCoefficient[#,{y,0,k}]&//Expand)/.{Dz->\[CurlyTheta]p[4][\[ScriptZ],q]/\[CurlyTheta][4][\[ScriptZ],q],Dz^n_:>\[CurlyTheta]ps[n][4][\[ScriptZ],q]/\[CurlyTheta][4][\[ScriptZ],q]}/.{\[ScriptZ]->1/(2\[Pi] I) Log[z]}],{k,1,maxDerivativeOrder}];
f/.rule/.{EEi[2][q]->EE2[q]}/.{EE2[q]->1/(12\[Pi]^2)*\[CurlyTheta]ppp[1][0,q]/\[CurlyTheta]p[1][0,q]}//RemoveLog//\[Theta]Expand

]
