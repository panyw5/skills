(*(* related by shift z \[Rule] z + \[Tau]/2 *)*)
(*\[Theta][1][2z,q^2]-(\[Theta][1][z,q]\[Theta][2][z,q])/\[Theta][4][0,q^2]//makeAbstract//makeqSeries//qSeries//Simplify*)
(*\[Theta][4][2z,q^2]-(\[Theta][3][z,q]\[Theta][4][z,q])/\[Theta][4][0,q^2]//makeAbstract//makeqSeries//qSeries//Simplify*)
