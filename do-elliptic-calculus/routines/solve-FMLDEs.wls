(* simplified MakeEquationqSeries *)
MakeEquationqSeries[f_] :=
 Simplify[
  f /. {cch -> ch, MMDO -> MDO, DDb -> Db, DDbi -> Dbi, EEE -> EE,
     EEi -> Ei, \[CapitalTheta]\[CapitalTheta] -> \[CapitalTheta], \
\[WeierstrassP]\[WeierstrassP] -> \[WeierstrassP]S} /. EEi -> Ei]


(* solve to the leading order in q *)
chorder = 0;
ch = q^\[Alpha] Sum[aaa[l][b[1]] q^l, {l, 0, chorder}];
order = chorder + 3;
q^-\[Alpha] eqs // MakeEquationqSeries //
   SeriesCoefficient[#, {q, 0, chorder}] & // Simplify;

(* find \[Alpha]=-1/8, \[Alpha]=5/8, \[Alpha]=1/8 and the \
corresponding equation that constrain aaa[0][b[1]] *)
Solve[% == 0, {\[Alpha]}~Join~
   Table[Derivative[k][aaa[chorder]][b[1]], {k, 0, 10}]] // Simplify


(* solve aaa[0][b[1]] *)

(* \[Alpha]\[Rule]-(1/8) *)
DSolve[aaa[0][b[1]] ==
  4/3 b[1] (-(((1 + 3 b[1]^2) Derivative[1][aaa[0]][b[1]])/(-1 +
       b[1]^2)) - b[1] (aaa[0]^\[Prime]\[Prime])[b[1]]), aaa[0][b[1]],
  b[1]]
(* \[Alpha]\[Rule]5/8 *)
DSolve[aaa[0][b[1]] == (
  b[1] (1 + b[1]^2) Derivative[1][aaa[0]][b[1]])/(-1 + b[1]^2),
 aaa[0][b[1]], b[1]]
(* \[Alpha]\[Rule]1/8 *)
DSolve[Derivative[1][aaa[0]][b[1]] == 0, aaa[0][b[1]], b[1]]


(* for \[Alpha]=-1/8, find aaa[1][b[1]] *)
chorder = 1;
ch = q^\[Alpha] Sum[
      aaa[l][b[1]] q^(l/2), {l, 0, chorder}] /. {\[Alpha] -> -(1/8),
     aaa[0][b[1]] -> -(Sqrt[b[1]]/(-1 + b[1]^2))} // Simplify;
order = chorder + 3;
q^-\[Alpha] eqs /. {\[Alpha] -> -(1/8)} // MakeEquationqSeries //
   SeriesCoefficient[#, {q, 0, chorder/2}] & // Simplify;
Solve[% == 0, {C[1], C[2]}~Join~
   Table[Derivative[k][aaa[chorder]][b[1]], {k, 0, 10}]] // Simplify

sol[1] =
 DSolve[aaa[1][b[1]] == (aaa[1][b[1]] /. %[[1]]), aaa[1][b[1]],
   b[1]][[1]]


chorder = 2;
ch = q^\[Alpha] Sum[
       aaa[l][b[1]] q^(l/2), {l, 0, chorder}] /. {\[Alpha] -> -(1/8),
